# Local ChatGPT-backed OpenAI-compatible proxy
# Start in a separate terminal:
#   npx openai-oauth@latest
# The proxy defaults to http://127.0.0.1:10531/v1
OPENAI_BASE_URL=http://127.0.0.1:10531/v1
# Set this to a model returned by /v1/models for your ChatGPT account.
OPENAI_OAUTH_MODEL=gpt-5.6-terra
# No real API key is required by the local OAuth proxy.
OPENAI_API_KEY=openai-oauth-local
